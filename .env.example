# Copy thành .env.local để chạy thử ở máy (file .env.local KHÔNG được commit).
# Trên GitHub, các giá trị này lấy từ Settings → Secrets and variables → Actions.

# Số điện thoại liên hệ (hiện nút Gọi / Zalo trên trang của từng khách)
SECRET_PHONE=

# Tên người gửi thư mời (tân khoa). Để trống nếu không muốn hiện tên.
SECRET_HOST_NAME=

# Danh sách khách dạng JSON trên một dòng. Ở máy có thể dùng file data/guests.json thay thế.
# Ví dụ: [{"code":"a7k2","honorific":"Anh","name":"Minh","message":"..."}]
SECRET_GUESTS_JSON=
