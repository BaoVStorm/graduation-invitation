# Copy thành .env.local để chạy thử ở máy (file .env.local KHÔNG được commit).
# Trên GitHub, giá trị lấy từ Settings → Secrets and variables → Actions.

# Số điện thoại liên hệ (nút Gọi / Zalo trên trang của từng khách)
SECRET_PHONE=

# Email nhận lời chúc (form "Gửi lời chúc"). Có thể là email hoặc URL endpoint (alias FormSubmit).
SECRET_WISH_EMAIL=
